# ========================================
# VARIABLES DE ENTORNO - EJEMPLO
# ========================================
# Copia este archivo como .env y configura tus valores reales

# Google Apps Script URL (obtenida de tu script desplegado)
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID_AQUI/exec

# Número de WhatsApp (sin espacios ni guiones)
WHATSAPP_NUMBER=1234567890

# Timeout para peticiones API (en milisegundos)
API_TIMEOUT=10000

# Modo debug (true/false)
DEBUG_MODE=false

# Configuraciones adicionales de seguridad
ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ========================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ========================================

# 1. Para desarrollo local:
#    - Copia este archivo como .env
#    - Reemplaza los valores de ejemplo con tus valores reales
#    - Nunca subas el archivo .env al repositorio

# 2. Para Vercel:
#    - Ve a tu proyecto en vercel.com/dashboard
#    - Settings → Environment Variables
#    - Añade cada variable con su valor correspondiente
#    - Configura por entorno: Development, Preview, Production

# 3. Para hosting compartido (cPanel, etc.):
#    - Configura las variables en el panel de control
#    - O usa un archivo PHP para inyectar las variables
#    - Asegúrate de que PHP esté habilitado

# 4. Para otros servicios (Netlify, etc.):
#    - Configura las variables en el dashboard del servicio
#    - Se inyectarán automáticamente en build time

# ========================================
# VARIABLES CRÍTICAS PARA VERCEL
# ========================================

# OBLIGATORIAS:
# APPS_SCRIPT_URL - Sin esta variable el formulario no funcionará

# RECOMENDADAS:
# WHATSAPP_NUMBER - Para redirección correcta
# DEBUG_MODE - false en producción, true en desarrollo

# OPCIONALES:
# API_TIMEOUT - Timeout por defecto es 10000ms