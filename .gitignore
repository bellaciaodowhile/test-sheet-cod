# ========================================
# ARCHIVOS SENSIBLES - NO SUBIR AL REPOSITORIO
# ========================================

# Variables de entorno
.env
.env.local
.env.production
.env.staging

# Archivos de configuración con datos sensibles
config.local.js
secrets.json
credentials.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos temporales
*.tmp
*.temp
.cache/
.temp/

# Archivos del sistema
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archivos de editor
.vscode/
.idea/
*.swp
*.swo
*~

# Dependencias
node_modules/
vendor/
bower_components/

# Archivos de build
dist/
build/
.next/
.nuxt/

